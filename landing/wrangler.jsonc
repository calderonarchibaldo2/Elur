// Elur landing — deploy with: npx wrangler deploy   (from the landing/ folder)
{
  "name": "elur",
  "compatibility_date": "2026-06-12",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "elur.io", "custom_domain": true },
    { "pattern": "www.elur.io", "custom_domain": true }
  ]
}
